local function MakeDraggable(handle, frame)
	local dragging, startPos, startFrame, moved = false, nil, nil, false
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, startPos, startFrame, moved = true, i.Position, frame.Position, false
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startPos
			if d.Magnitude > 6 then moved = true end
			frame.Position = UDim2.new(startFrame.X.Scale, startFrame.X.Offset + d.X, startFrame.Y.Scale, startFrame.Y.Offset + d.Y)
		end
	end)
	return function() return moved end   -- true if the last press turned into a drag
end

local IS_TOUCH = UserInputService.TouchEnabled
local function FitScale()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	if IS_TOUCH then
		-- phones / tablets: keep the whole 660x430 window (and the 440x330 key card) inside the screen
		return math.clamp(math.min(vp.X * 0.8 / 640, vp.Y * 0.72 / 440), 0.3, 0.8)
	end
	return math.clamp(math.min(vp.X / 800, vp.Y / 560), 0.5, 0.85)
end

