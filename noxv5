-- HIDE / SHOW UI  +  MUSIC ON / OFF  (small buttons that always stay on screen)
do
	local musicOn = true
	local BGM = New("Sound", {Name = "IS_BGM", Looped = true, Volume = 1.6}, SoundService)
	task.spawn(function()
		local t0 = os.clock()
		while not BG.MusicAsset and not BG.Done and os.clock() - t0 < 60 do task.wait(0.2) end
		if BG.MusicAsset and BGM.Parent then BGM.SoundId = BG.MusicAsset end
	end)
	-- keep the music locked to the video: it starts together with the video and is corrected whenever it drifts
	task.spawn(function()
		local vlen = FRAMES.frames / FRAMES.fps
		while BGM.Parent do
			task.wait(0.4)
			pcall(function()
				if not musicOn or BGM.SoundId == "" then return end
				local me
				for _, e in ipairs(BG.Entries) do
					if e.main and e.holder.Parent then me = e end
				end
				local vt, vl
				if BG.UseMP4 then
					if me and me.video and me.video.IsLoaded and me.video.IsPlaying then
						vt, vl = me.video.TimePosition, me.video.TimeLength
					end
				elseif BG.Ready and me and me.slots and BG.Began then
					vt, vl = (os.clock() - BG.Start) % vlen, vlen
				elseif BG.Done and not BG.Ready and not BG.UseMP4 and not BGM.IsPlaying then
					BGM:Play()   -- no video on this executor: just play the music
					return
				end
				if vt then
					if not BGM.IsPlaying then
						BGM.TimePosition = math.min(vt, math.max(BGM.TimeLength - 0.1, 0))
						BGM:Play()
					else
						local d = math.abs(BGM.TimePosition - vt)
						d = math.min(d, math.max((vl or vlen) - d, 0))
						if d > 0.25 then BGM.TimePosition = math.min(vt, math.max(BGM.TimeLength - 0.1, 0)) end
					end
				end
			end)
		end
	end)
	Gui.Destroying:Connect(function() pcall(function() BGM:Destroy() end) end)

	local Bar = New("Frame", {Name = "QuickBar", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(176, 34), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 60}, Gui)
	if IS_TOUCH then New("UIScale", {Scale = 0.85}, Bar) end

	local function QuickButton(x, text, cb)
		local b = New("TextButton", {Position = UDim2.fromOffset(x, 0), Size = UDim2.fromOffset(84, 34), BackgroundColor3 = Color3.fromRGB(12, 8, 12),
			BackgroundTransparency = 0.25, BorderSizePixel = 0, Text = text, TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 12,
			AutoButtonColor = false, ZIndex = 61}, Bar)
		Corner(b, 12)
		Rainbow(Stroke(b, WHITE, 1.5))
		b.MouseButton1Click:Connect(function() Click() cb(b) end)
		return b
	end

	QuickButton(0, "🎵  MUSIC ON", function(b)
		musicOn = not musicOn
		b.Text = musicOn and "🎵  MUSIC ON" or "🔇  MUSIC OFF"
		pcall(function()
			if musicOn then
				if BGM.SoundId ~= "" then BGM:Resume() if not BGM.IsPlaying then BGM:Play() end end
			else
				BGM:Pause()
			end
		end)
	end)

	QuickButton(92, "👁  HIDE UI", function(b)
		uiHidden = not uiHidden
		b.Text = uiHidden and "👁  SHOW UI" or "👁  HIDE UI"
		Toggler.Visible = not uiHidden
		if uiHidden then
			-- hide every feature, keep only the video background
			if not open then SetOpen(true) end
			hiddenByUI = {}
			for _, c in ipairs(Main:GetChildren()) do
				if c:IsA("GuiObject") and c.Name ~= "BG" and c.Visible then
					hiddenByUI[#hiddenByUI + 1] = c
					c.Visible = false
				end
			end
		else
			-- bring the features back (video stays)
			for _, c in ipairs(hiddenByUI) do
				if c.Parent then c.Visible = true end
			end
			hiddenByUI = {}
		end
	end)
end

-- RGB EVERYWHERE: every outline cycles through rainbow colors and every text (buttons, labels, paragraphs, tabs, boxes) gets a light RGB color
do
	local items = {}
	local function Register(o)
		if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
			items[#items + 1] = {o = o, text = true, off = (#items * 0.012) % 1}
		elseif o:IsA("UIStroke") then
			items[#items + 1] = {o = o, text = false, off = (#items * 0.012) % 1}
		end
	end
	for _, d in ipairs(Gui:GetDescendants()) do Register(d) end
	Gui.DescendantAdded:Connect(function(d) task.defer(Register, d) end)
	task.spawn(function()
		while Gui.Parent do
			local t = os.clock() * 0.3
			for i = #items, 1, -1 do
				local it = items[i]
				local o = it.o
				if not o.Parent then
					table.remove(items, i)
				elseif it.text then
					o.TextColor3 = Color3.fromHSV((t + it.off) % 1, 0.55, 1)
				else
					o.Color = Color3.fromHSV((t + it.off) % 1, 1, 1)
					if o.Transparency > 0.4 then o.Transparency = 0.3 end
					if o.Thickness < 1.2 then o.Thickness = 1.2 end
				end
			end
			task.wait(0.04)
		end
	end)
