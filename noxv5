local SLOTS = 4
local function BuildLayers(e)
	local scale = math.max(e.w / FRAMES.fw, e.h / FRAMES.fh)
	e.slots = {}
	for k = 1, SLOTS do
		e.slots[k] = {sheet = 0, label = New("ImageLabel", {Name = "Slot" .. k, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(math.ceil(FRAMES.fw * scale), math.ceil(FRAMES.fh * scale)), BackgroundTransparency = 1,
			BorderSizePixel = 0, Image = "", ImageTransparency = 1, ImageRectSize = Vector2.new(FRAMES.fw - 2, FRAMES.fh - 2),
			ZIndex = e.z}, e.holder)}
	end
end

-- keeps the current sheet and the next two loaded; the picture is already in memory before it is shown,
-- and only 4 pictures exist at a time (not all 86), which removes the flicker / stutter.
local function SetSheets(e, cur)
	local count = #FRAMES.sheets
	local need = {cur, cur % count + 1, (cur + 1) % count + 1}
	local used = {}
	for rank, sheet in ipairs(need) do
		local slot
		for _, sl in ipairs(e.slots) do
			if sl.sheet == sheet then slot = sl break end
		end
		if not slot then
			for _, sl in ipairs(e.slots) do
				local keep = false
				for _, nd in ipairs(need) do if sl.sheet == nd then keep = true end end
				if not keep then slot = sl break end
			end
			slot.sheet = sheet
			slot.label.ImageTransparency = 1
			slot.label.Image = BG.Assets[sheet] or ""
		end
		if slot.label.Image == "" and BG.Assets[sheet] then slot.label.Image = BG.Assets[sheet] end
		used[slot] = rank
		slot.label.ZIndex = e.z + 4 - rank
		slot.label.ImageTransparency = 0
	end
	for _, sl in ipairs(e.slots) do
		if not used[sl] then
			sl.label.ImageTransparency = 1
			sl.label.ZIndex = e.z
		end
	end
	e.curSlot = nil
	for _, sl in ipairs(e.slots) do if sl.sheet == cur then e.curSlot = sl end end
end

local function BuildMP4(e)
	local scale = math.max(e.w / 1280, e.h / 720)
	local v = New("VideoFrame", {Name = "BGVideo", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(math.ceil(1280 * scale), math.ceil(720 * scale)), BackgroundTransparency = 1, BorderSizePixel = 0,
		Video = BG.MP4Asset, Looped = true, Volume = 0, ZIndex = e.z + 5}, e.holder)
	e.video = v
	pcall(function() v:Play() end)
	task.spawn(function()
		local t0 = os.clock()
		while v.Parent and not v.IsLoaded and os.clock() - t0 < 15 do task.wait(0.1) end
		if v.Parent and v.IsLoaded then
			pcall(function() v:Play() end)
			task.wait(0.3)
			if e.fallback then e.fallback:Destroy() e.fallback = nil end
		elseif v.Parent then
			v:Destroy()
			e.video = nil
		end
	end)
end

RunService.RenderStepped:Connect(function()
	if BG.UseMP4 then
		for i = #BG.Entries, 1, -1 do
			local e = BG.Entries[i]
			if not e.holder.Parent then table.remove(BG.Entries, i)
			elseif not e.video then BuildMP4(e) end
		end
		return
	end
	local now = os.clock()
	local dt = now - (BG.Last or now)
	BG.Last = now
	local idx = math.floor((now - BG.Start) * FRAMES.fps) % FRAMES.frames
	local sheet = math.floor(idx / FRAMES.per) + 1
	if not BG.Assets[sheet] then
		BG.Start = BG.Start + dt   -- next picture is still being prepared: hold this frame
		return
	end
	local inSheet = idx % FRAMES.per
	local off = Vector2.new((inSheet % FRAMES.cols) * FRAMES.fw + 1, math.floor(inSheet / FRAMES.cols) * FRAMES.fh + 1)
	for i = #BG.Entries, 1, -1 do
		local e = BG.Entries[i]
		if not e.holder.Parent then
			table.remove(BG.Entries, i)
		else
			if BG.Ready and not e.slots then BuildLayers(e) end
			if e.slots then
				if e.main and not BG.Began then
					BG.Began = true
					BG.Start = os.clock()
				end
				if e.sheet ~= sheet then
					e.sheet = sheet
					SetSheets(e, sheet)
				end
				local cur = e.curSlot and e.curSlot.label
				if cur then
					cur.ImageRectOffset = off
					-- keep the animated fallback underneath until the video picture is really on screen
					if e.fallback and cur.IsLoaded then
						e.loadedFrames = (e.loadedFrames or 0) + 1
						if e.loadedFrames > 8 then e.fallback:Destroy() e.fallback = nil end
					end
				end
			end
		end
	end
end)

-- background: embedded video frames, or an animated gradient + particles while loading / if unsupported
local function BuildBackground(parent, zindex, w, h, noVideo)
	local holder = New("Frame", {Name = "BG", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 6, 10),
		BorderSizePixel = 0, ClipsDescendants = true, ZIndex = zindex or 1}, parent)

	local fb = New("Frame", {Name = "Fallback", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ZIndex = zindex or 1}, holder)
	local grad = New("Frame", {Size = UDim2.fromScale(2, 2), Position = UDim2.fromScale(-0.5, -0.5),
		BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = zindex or 1}, fb)
	local ug = New("UIGradient", {Rotation = 0}, grad)
	OnAccent(function(c)
		ug.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(8, 4, 8)),
			ColorSequenceKeypoint.new(0.5, c:Lerp(Color3.new(0, 0, 0), 0.65)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 4, 8)),
		})
	end)
	task.spawn(function()
		while grad.Parent do
			ug.Rotation = (os.clock() * 12) % 360
			task.wait(1 / 30)
		end
	end)
	for i = 1, 14 do
		local size = math.random(3, 7)
		local p = New("Frame", {Size = UDim2.fromOffset(size, size), BackgroundColor3 = WHITE, BackgroundTransparency = 0.6,
			BorderSizePixel = 0, Position = UDim2.fromScale(math.random(), math.random()), ZIndex = (zindex or 1) + 1}, fb)
		Corner(p, 8)
		OnAccent(function(c) p.BackgroundColor3 = c end)
		task.spawn(function()
			while p.Parent do
				local t = math.random(40, 90) / 10
				local tw = Tween(p, t, {Position = UDim2.fromScale(math.random(), math.random()),
					BackgroundTransparency = math.random(40, 90) / 100}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				tw.Completed:Wait()
			end
		end)
	end

	if CONFIG.BackgroundVideo and not noVideo then
		table.insert(BG.Entries, {holder = holder, fallback = fb, w = w or 660, h = h or 430, z = zindex or 1, main = (parent.Name == "Main")})
	end
	return holder
end

