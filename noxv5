	local function updateAutocompleteList(searchText, box)
	    if not autocompleteFrame or not autocompleteList then return end

	    local listFrame = autocompleteList
	    local searchLower = searchText:lower()
	    local matchingPlayers = {}
	    local maxResults = 10

	    if searchText == "" or searchText == "Username or UserID" or #searchText < 1 then
	        autocompleteFrame.Visible = false
	        isAutocompleteVisible = false
	        return
	    end

	    for _, player in ipairs(Players:GetPlayers()) do
	        if player ~= LocalPlayer then
	            if player.Name:lower():sub(1, #searchLower) == searchLower
	                or player.DisplayName:lower():sub(1, #searchLower) == searchLower then
	                table.insert(matchingPlayers, player)
	            end
	        end
	    end

	    if #matchingPlayers == 0 then
	        autocompleteFrame.Visible = false
	        isAutocompleteVisible = false
	        return
	    end

	    for i = #matchingPlayers, maxResults + 1, -1 do
	        table.remove(matchingPlayers, i)
	    end

	    for _, child in ipairs(listFrame:GetChildren()) do
	        if child:IsA("Frame") or child:IsA("TextButton") then child:Destroy() end
	    end

	    local itemHeight, padding = 30, 2
	    local totalHeight = (#matchingPlayers * (itemHeight + padding)) + padding
	    listFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight)

	    for i, player in ipairs(matchingPlayers) do
	        local itemButton = Instance.new("TextButton")
	        itemButton.BorderSizePixel = 0
	        itemButton.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
	        itemButton.Size = UDim2.new(1, -4, 0, itemHeight)
