	local function findPeopleContainer()
	    local function searchForPeople(parent)
	        if not parent then return nil end
	        for _, child in ipairs(parent:GetChildren()) do
	            if child.Name == "People" and (child:IsA("Frame") or child:IsA("ScrollingFrame")) then
	                return child
	            end
	            if #child:GetChildren() > 0 then
	                local result = searchForPeople(child)
	                if result then return result end
	            end
	        end
	        return nil
	    end
	    return searchForPeople(CoreGui)
	end

	local function destroyPlayerCard(player)
	    if not player then return false end
	    local people = findPeopleContainer()
	    if not people then return false end
	    local destroyed = false
	    for _, child in ipairs(people:GetChildren()) do
	        local hasPlayerName = false
	        for _, d in ipairs(child:GetDescendants()) do
	            if d:IsA("TextLabel") or d:IsA("TextButton") then
	                local text = tostring(d.Text or "")
	                if text == player.Name or text == player.DisplayName then
	                    hasPlayerName = true
	                    break
	                end
	            end
	        end
	        if hasPlayerName then
	            pcall(function() child:Destroy() destroyed = true end)
	        end
	    end
	    return destroyed
	end

