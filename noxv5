	local function findPlayer(input)
	    local userId = tonumber(input)
	    if userId then
	        for _, player in ipairs(Players:GetPlayers()) do
	            if player.UserId == userId then return player end
	        end
	    else
	        local searchName = input:lower()
	        for _, player in ipairs(Players:GetPlayers()) do
	            if player.Name:lower() == searchName or player.DisplayName:lower() == searchName then
	                return player
	            end
	        end
	    end
	    return nil
	end

	local function banPlayer(player, reason, duration)
	    if not player then
	        ShowNotification("Player not found!", true)
	        return false
	    end
	    if player == LocalPlayer then
	        ShowNotification("You cannot ban yourself!", true)
	        return false
	    end

	    local playerName, playerId = player.Name, player.UserId
	    local untilTime = (duration and duration > 0) and (os.time() + duration) or math.huge

	    bannedPlayers[playerId] = {name = playerName, reason = reason or "No reason", untilTime = untilTime}

	    local banUI = nil
	    pcall(function() banUI = ShowFakeBanUI(player, reason) end)
	    if banUI then pcall(function() banUI:Destroy() end) end

	    hideCharacter(player)
	    destroyPlayerCard(player)
	    hidePlayerInPlayerList(player)
	    startContinuousHiding(player)

	    if duration and duration > 0 then
	        ShowNotification(string.format("%s has been banned for %s seconds!", playerName, duration), false)
	    else
	        ShowNotification(string.format("%s has been PERMANENTLY banned!", playerName), false)
	    end
	    return true
	end

	local function unbanPlayer(input)
	    local userId = tonumber(input)
	    local playerName = nil

	    if userId and bannedPlayers[userId] then
	        playerName = bannedPlayers[userId].name
	    else
	        for id, data in pairs(bannedPlayers) do
	            if data.name:lower() == input:lower() then
	                userId = id
	                playerName = data.name
	                break
	            end
	        end
	    end

	    if not userId or not bannedPlayers[userId] then
	        ShowNotification(string.format("Player '%s' not found in ban list!", input), true)
	        return false
	    end

	    removeTasks[userId] = nil
	    bannedPlayers[userId] = nil
	    restorePlayerInPlayerList(userId)
	    restoreCharacter(userId)
	    ShowNotification(string.format("%s has been unbanned!", playerName), false)
	    return true
	end

	task.spawn(function()
	    while true do
	        local currentTime = os.time()
	        for userId, data in pairs(bannedPlayers) do
	            if data.untilTime and data.untilTime ~= math.huge and data.untilTime <= currentTime then
	                local playerName = data.name
	                removeTasks[userId] = nil
	                bannedPlayers[userId] = nil
	                restorePlayerInPlayerList(userId)
	                restoreCharacter(userId)
	                ShowNotification(string.format("%s has been unbanned! (Time out)", playerName), false)
	            end
	        end
	        task.wait(1)
	    end
	end)

	local function setupPlayer(player)
	    if player == LocalPlayer then return end

	    player.CharacterAdded:Connect(function(character)
	        task.wait(0.1)
	        if bannedPlayers[player.UserId] or bannedAllList[player.UserId] then
	            hiddenCharacters[player.UserId] = character
	            pcall(function() character.Parent = nil end)
	            destroyPlayerCard(player)
	            hidePlayerInPlayerList(player)
	            startContinuousHiding(player)
	        end
	    end)

	    if player.Character and (bannedPlayers[player.UserId] or bannedAllList[player.UserId]) then
	        hideCharacter(player)
	        destroyPlayerCard(player)
	        hidePlayerInPlayerList(player)
	        startContinuousHiding(player)
	    end
	end

	Players.PlayerAdded:Connect(setupPlayer)
	for _, player in ipairs(Players:GetPlayers()) do setupPlayer(player) end

	local function SendChatMessage(message)
	    pcall(function()
	        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	            TextChatService.TextChannels.RBXGeneral:SendAsync(message)
	        else
	            game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(message, "All")
	        end
	    end)
	end

	local function banAllPlayers()
	    local count = 0
	    for _, player in ipairs(Players:GetPlayers()) do
	        if player ~= LocalPlayer then
	            bannedAllList[player.UserId] = true
	            pcall(function()
	                if player.Character then player.Character:Destroy() end
	                player:Destroy()
	                count = count + 1
	            end)
	        end
	    end

	    for _, obj in ipairs(workspace:GetChildren()) do
	        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj ~= LocalPlayer.Character then
	            pcall(function() obj:Destroy() end)
	        end
	    end

	    SendChatMessage("/clear")
	    ShowNotification(string.format("Successfully banned %s players!", count), false)

	    for _, player in ipairs(Players:GetPlayers()) do
	        if player ~= LocalPlayer then setupPlayer(player) end
	    end
	end

