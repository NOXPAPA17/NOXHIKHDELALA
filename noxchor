-- [🔥 TARGET FINDER]
local function getTarget()
local name = _G.TargetName:lower()
if name == "" then return nil end
for _, p in pairs(Players:GetPlayers()) do
if p ~= player and (p.Name:lower():find(name) or p.DisplayName:lower():find(name)) then
return p
end
end
return nil
end

-- [🔥 SUGGESTIONS]
local function getSuggestions(query)
local suggestions = {}
query = query:lower()
if query == "" then return suggestions end
for _, p in pairs(Players:GetPlayers()) do
if p ~= player then
local name = p.Name:lower()
local display = p.DisplayName:lower()
if name:find(query) or display:find(query) then
table.insert(suggestions, p)
end
end
end
return suggestions
end

-- [🔥 STICKY PHYSICS - 0 DELAY]
RunService.Heartbeat:Connect(function()
local myChar = player.Character
local myHum = myChar and myChar:FindFirstChild("Humanoid")

if _G.AntiSit and myHum and myHum.Sit then
myHum.Sit = false
end

if _G.Loop then
local target = getTarget()
if target and target.Character then
local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
local targetHead = target.Character:FindFirstChild("Head")

if myRoot and targetRoot and targetHead then
for _, v in pairs(myChar:GetDescendants()) do
if v:IsA("BasePart") then
v.CanCollide = false
v.Massless = true
end
end

local targetVel = targetRoot.Velocity * (1/60)
local sine = math.sin(tick() * _G.Speed) * 0.8

if _G.Mode == "Mouth" then
local targetPos = targetHead.CFrame * CFrame.new(0, 0, -_G.Distance - 0.2) * CFrame.Angles(0, math.pi, 0)
myRoot.CFrame = targetPos + (targetHead.CFrame.LookVector * (sine * 0.7)) + targetVel
else
local targetPos = targetRoot.CFrame * CFrame.new(0, 0, _G.Distance + 0.6 + sine) * CFrame.Angles(math.rad(sine * 18), 0, 0)
myRoot.CFrame = targetPos + targetVel
end

myRoot.Velocity = Vector3.new(0, 0, 0)
myRoot.RotVelocity = Vector3.new(0, 0, 0)
end
end
end
end)

