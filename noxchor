local function updateSuggestions()
local query = Input.Text
local suggestions = getSuggestions(query)

for _, child in pairs(SuggestionFrame:GetChildren()) do
if child:IsA("TextButton") then
child:Destroy()
end
end

if #suggestions > 0 and query ~= "" then
SuggestionFrame.Visible = true
SuggestionFrame.Size = UDim2.new(0.85, 0, 0, math.min(#suggestions * 24 + 5, 70))

for _, p in pairs(suggestions) do
local btn = Instance.new("TextButton", SuggestionFrame)
btn.Size = UDim2.new(1, -6, 0, 22)
btn.Position = UDim2.new(0, 3, 0, 0)
btn.Text = p.Name
btn.TextColor3 = Color3.fromRGB(0, 255, 0)
btn.TextSize = 12
btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
btn.BackgroundTransparency = 0
btn.Font = Enum.Font.Gotham
btn.TextXAlignment = Enum.TextXAlignment.Left
btn.ZIndex = 25
btn.BorderSizePixel = 0
Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

btn.MouseButton1Click:Connect(function()
_G.TargetName = p.Name
Input.Text = p.Name
SuggestionFrame.Visible = false
end)

btn.MouseEnter:Connect(function()
btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
end)
btn.MouseLeave:Connect(function()
btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
end)
end
else
SuggestionFrame.Visible = false
end
end

